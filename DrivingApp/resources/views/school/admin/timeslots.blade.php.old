    <script>
    const instructors = <?php echo json_encode($instructors); ?>;
    const timeslotBaseUrl = '{{ $schoolUrl("admin/timeslots") }}';

        // Bulk timeslot arrays
        let selectedTimeslotDates = [];
        let timeslotsTimeSlots = [];
        let bulkTimeslotsList = [];

        // Initialize timeslots page functionality
        function initializeTimeslotsPage() {
            // Handle hash-based navigation (from schedule links)
            if (window.location.hash) {
                const timeslotId = window.location.hash.substring(1); // Remove '#'
                const timeslotElement = document.getElementById(timeslotId);
                if (timeslotElement) {
                    setTimeout(() => {
                        timeslotElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        // Highlight the timeslot
                        timeslotElement.style.backgroundColor = '#fff3cd';
                        timeslotElement.style.transition = 'background-color 2s';
                        setTimeout(() => {
                            timeslotElement.style.backgroundColor = '';
                        }, 2000);
                    }, 300);
                }
            }
        }

        // Call on DOMContentLoaded (initial page load)
        document.addEventListener("DOMContentLoaded", initializeTimeslotsPage);
        
        // Also call immediately (for AJAX navigation)
        if (document.readyState === 'loading') {
            // Still loading, wait for DOMContentLoaded
        } else {
            // Already loaded (AJAX navigation), initialize now
            initializeTimeslotsPage();
        }

        window.toggleInstructorSelection = function() {
            const checked = document.getElementById('assign_instructors_check').checked;
            document.getElementById('instructor_selection').style.display = checked ? 'block' : 'none';
        }

        window.openCreateModal = function() {
            document.getElementById('createModal').style.display = 'flex';
            resetTimeslotForm();
        }

        window.closeCreateModal = function() {
            document.getElementById('createModal').style.display = 'none';
            resetTimeslotForm();
        }

        // Toggle between single and bulk mode
        window.toggleBulkTimeslotMode = function() {
            const isBulk = document.getElementById('bulkTimeslotToggle').checked;
            document.getElementById('singleTimeslotSection').style.display = isBulk ? 'none' : 'block';
            document.getElementById('bulkTimeslotSection').style.display = isBulk ? 'block' : 'none';
            
            // Toggle required attributes
            document.getElementById('singleTimeslotDate').required = !isBulk;
            document.getElementById('singleTimeslotStartTime').required = !isBulk;
            document.getElementById('singleTimeslotEndTime').required = !isBulk;
        }

        // Date management
        window.addTimeslotDate = function() {
            const datePicker = document.getElementById('bulkTimeslotDatePicker');
            const date = datePicker.value;
            
            if (date && !selectedTimeslotDates.includes(date)) {
                selectedTimeslotDates.push(date);
                renderSelectedTimeslotDates();
                datePicker.value = '';
            }
        }

        window.renderSelectedTimeslotDates = function() {
            const container = document.getElementById('selectedTimeslotDates');
            container.innerHTML = selectedTimeslotDates.map(date => {
                const formatted = new Date(date + 'T00:00:00').toLocaleDateString('en-US', { 
                    month: 'short', day: 'numeric', year: 'numeric' 
                });
                return `<span class="date-badge" onclick="removeTimeslotDate('${date}')">📅 ${formatted} ✕</span>`;
            }).join('');
        }

        window.removeTimeslotDate = function(date) {
            selectedTimeslotDates = selectedTimeslotDates.filter(d => d !== date);
            renderSelectedTimeslotDates();
        }

        // Time slot management
        window.toggleMultipleSlotsTimeslot = function() {
            const isMultiple = document.getElementById('multipleSlotsTimeslotToggle').checked;
            document.getElementById('singleSlotSectionTimeslot').style.display = isMultiple ? 'none' : 'block';
            document.getElementById('multipleSlotsSection Timeslot').style.display = isMultiple ? 'block' : 'none';
        }

        window.addTimeSlotTimeslot = function() {
            const startTime = document.getElementById('newSlotStartTimeslot').value;
            const endTime = document.getElementById('newSlotEndTimeslot').value;
            
            if (startTime && endTime) {
                timeslotsTimeSlots.push({ start_time: startTime, end_time: endTime });
                renderTimeslotsTimeSlots();
                document.getElementById('newSlotStartTimeslot').value = '';
                document.getElementById('newSlotEndTimeslot').value = '';
            } else {
                alert('Please enter both start and end times');
            }
        }

        window.renderTimeslotsTimeSlots = function() {
            const container = document.getElementById('timeSlotsListTimeslot');
            container.innerHTML = timeslotsTimeSlots.map((slot, index) => {
                const start = new Date(`2000-01-01T${slot.start_time}`).toLocaleTimeString('en-US', { 
                    hour: 'numeric', minute: '2-digit' 
                });
                const end = new Date(`2000-01-01T${slot.end_time}`).toLocaleTimeString('en-US', { 
                    hour: 'numeric', minute: '2-digit' 
                });
                return `
                    <div class="time-slot-item-preview">
                        <span>⏰ ${start} - ${end}</span>
                        <button type="button" class="btn btn-delete" onclick="removeTimeslotTimeSlot(${index})" style="padding: 4px 8px;">✕</button>
                    </div>
                `;
            }).join('');
        }

        window.removeTimeslotTimeSlot = function(index) {
            timeslotsTimeSlots.splice(index, 1);
            renderTimeslotsTimeSlots();
        }

        // Add bulk timeslots to list
        window.addBulkTimeslotsToList = function() {
            const maxInstructors = document.getElementById('bulkMaxInstructors').value;
            const notes = document.getElementById('bulkNotes').value;
            const isMultipleSlots = document.getElementById('multipleSlotsTimeslotToggle').checked;
            
            if (selectedTimeslotDates.length === 0) {
                alert('Please select at least one date');
                return;
            }

            let newTimeslots = [];

            if (isMultipleSlots) {
                // Multiple slots mode
                if (timeslotsTimeSlots.length === 0) {
                    alert('Please add at least one time slot');
                    return;
                }
                
                selectedTimeslotDates.forEach(date => {
                    timeslotsTimeSlots.forEach(slot => {
                        newTimeslots.push({
                            date: date,
                            start_time: slot.start_time,
                            end_time: slot.end_time,
                            max_instructors: maxInstructors,
                            notes: notes
                        });
                    });
                });
            } else {
                // Single slot mode
                const startTime = document.getElementById('bulkTimeslotStartTime').value;
                const endTime = document.getElementById('bulkTimeslotEndTime').value;
                
                if (!startTime || !endTime) {
                    alert('Please enter start and end times');
                    return;
                }
                
                selectedTimeslotDates.forEach(date => {
                    newTimeslots.push({
                        date: date,
                        start_time: startTime,
                        end_time: endTime,
                        max_instructors: maxInstructors,
                        notes: notes
                    });
                });
            }

            bulkTimeslotsList = bulkTimeslotsList.concat(newTimeslots);
            renderTimeslotsPreview();
            
            // Clear selections
            selectedTimeslotDates = [];
            timeslotsTimeSlots = [];
            renderSelectedTimeslotDates();
            renderTimeslotsTimeSlots();
            document.getElementById('bulkTimeslotStartTime').value = '';
            document.getElementById('bulkTimeslotEndTime').value = '';
            document.getElementById('multipleSlotsTimeslotToggle').checked = false;
            toggleMultipleSlotsTimeslot();
            
            alert(`Added ${newTimeslots.length} time slot(s)!`);
        }

        // Render timeslots preview
        window.renderTimeslotsPreview = function() {
            const container = document.getElementById('timeslotsListPreview');
            document.getElementById('timeslotCounter').textContent = bulkTimeslotsList.length;
            
            if (bulkTimeslotsList.length === 0) {
                container.innerHTML = '<p style="color: #999; text-align: center; padding: 20px;">No time slots added yet</p>';
                return;
            }

            // Group by date
            const timeslotsByDate = {};
            bulkTimeslotsList.forEach((timeslot, index) => {
                if (!timeslotsByDate[timeslot.date]) {
                    timeslotsByDate[timeslot.date] = [];
                }
                timeslotsByDate[timeslot.date].push({ ...timeslot, originalIndex: index });
            });

            // Render grouped by date
            const sortedDates = Object.keys(timeslotsByDate).sort();
            container.innerHTML = sortedDates.map(date => {
                const formatted = new Date(date + 'T00:00:00').toLocaleDateString('en-US', { 
                    month: 'short', day: 'numeric', year: 'numeric' 
                });
                const timeslotsForDate = timeslotsByDate[date];
                
                return `
                    <div style="margin-bottom: 15px;">
                        <div style="font-weight: bold; color: #FF9800; margin-bottom: 5px;">📅 ${formatted}</div>
                        ${timeslotsForDate.map(timeslot => {
                            const start = new Date(`2000-01-01T${timeslot.start_time}`).toLocaleTimeString('en-US', { 
                                hour: 'numeric', minute: '2-digit' 
                            });
                            const end = new Date(`2000-01-01T${timeslot.end_time}`).toLocaleTimeString('en-US', { 
                                hour: 'numeric', minute: '2-digit' 
                            });
                            return `
                                <div class="time-slot-item-preview" style="margin-left: 15px;">
                                    <span>⏰ ${start} - ${end} (Max: ${timeslot.max_instructors})</span>
                                    <button type="button" class="btn btn-delete" onclick="removeTimeslotFromList(${timeslot.originalIndex})" style="padding: 4px 8px;">✕</button>
                                </div>
                            `;
                        }).join('')}
                    </div>
                `;
            }).join('');
        }

        window.removeTimeslotFromList = function(index) {
            bulkTimeslotsList.splice(index, 1);
            renderTimeslotsPreview();
        }

        // Form submission
        document.getElementById('createTimeslotForm').addEventListener('submit', function(e) {
            const isBulk = document.getElementById('bulkTimeslotToggle').checked;
            
            if (isBulk) {
                if (bulkTimeslotsList.length === 0) {
                    e.preventDefault();
                    alert('Please add at least one time slot to the list');
                    return;
                }
                document.getElementById('timeslotsDataInput').value = JSON.stringify(bulkTimeslotsList);
            }
        });

        // Reset form
        function resetTimeslotForm() {
            document.getElementById('createTimeslotForm').reset();
            document.getElementById('bulkTimeslotToggle').checked = false;
            toggleBulkTimeslotMode();
            selectedTimeslotDates = [];
            timeslotsTimeSlots = [];
            bulkTimeslotsList = [];
            renderSelectedTimeslotDates();
            renderTimeslotsTimeSlots();
            renderTimeslotsPreview();
        }

        window.openAssignModal = function(button) {
            const slotId = button.dataset.slotId;
            const assignedIds = JSON.parse(button.dataset.assigned || '[]');
            const form = document.getElementById('assignForm');
            form.action = `${timeslotBaseUrl}/${slotId}/assign`;

            const list = document.getElementById('assignInstructorsList');
            list.innerHTML = '';

            instructors.forEach(instructor => {
                const isAssigned = assignedIds.includes(instructor.id);
                list.innerHTML += `
                    <div class="checkbox-item">
                        <label>
                            <input type="checkbox" name="instructors[]" value="${instructor.id}" ${isAssigned ? 'checked' : ''}>
                            ${instructor.name}
                        </label>
                    </div>
                `;
            });
            
            document.getElementById('assignModal').style.display = 'flex';
        }

        window.closeAssignModal = function() {
            document.getElementById('assignModal').style.display = 'none';
        }

        window.openDeleteModal = function(button) {
            const slotId = button.dataset.slotId;
            const form = document.getElementById('deleteForm');
            form.action = `${timeslotBaseUrl}/${slotId}`;
            document.getElementById('deleteModal').style.display = 'flex';
        }

        window.closeDeleteModal = function() {
            document.getElementById('deleteModal').style.display = 'none';
        }

        window.onclick = (event) => {
            if (event.target.classList.contains('modal')) {
                event.target.style.display = 'none';
            }
        }

        // Toggle individual date section
        window.toggleDate = function(date) {
            const element = document.getElementById('timeslots-' + date);
            const header = element.previousElementSibling;
            
            if (element.classList.contains('collapsed')) {
                element.classList.remove('collapsed');
                header.classList.remove('collapsed');
            } else {
                element.classList.add('collapsed');
                header.classList.add('collapsed');
            }
        }

        // Toggle all date sections
        let allCollapsed = false;
        window.toggleAllDates = function() {
            const allSections = document.querySelectorAll('.date-timeslots');
            const allHeaders = document.querySelectorAll('.date-header');
            const toggleText = document.getElementById('toggleAllText');
            
            allCollapsed = !allCollapsed;
            
            allSections.forEach(section => {
                if (allCollapsed) {
                    section.classList.add('collapsed');
                } else {
                    section.classList.remove('collapsed');
                }
            });
            
            allHeaders.forEach(header => {
                if (allCollapsed) {
                    header.classList.add('collapsed');
                } else {
                    header.classList.remove('collapsed');
                }
            });
            
            toggleText.textContent = allCollapsed ? 'Expand All' : 'Collapse All';
        }
    </script>
</div>
@endsection